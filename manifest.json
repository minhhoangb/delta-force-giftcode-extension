{
  "manifest_version": 3,
  "name": "Delta Force Giftcode TXT",
  "description": "Đọc giftcode từ file TXT và điền lần lượt trên trang đổi quà Delta Force Garena.",
  "version": "1.0.1",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://redeem.df.garena.sg/*"
  ],
  "action": {
    "default_title": "Delta Force Giftcode TXT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://redeem.df.garena.sg/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
